# Copy to .env.agent at the repository root. Never commit the copied file.
# These values are read ONLY by Node, never by Vite/browser code.
FOLIOHUSH_APP_ORIGIN=http://127.0.0.1:5173
FOLIOHUSH_AGENT_MODE=local
FOLIOHUSH_AGENT_PORT=3001

# Set all three explicitly using your provider's current documentation.
# Base URL ends at the API prefix, e.g. https://api.openai.com/v1.
# The gateway appends /chat/completions; there is no provider/model default.
FOLIOHUSH_AI_BASE_URL=
FOLIOHUSH_AI_MODEL=
FOLIOHUSH_AI_API_KEY=
FOLIOHUSH_AI_TIMEOUT_MS=45000

# Optional, only for a provider you operate on this same machine:
# FOLIOHUSH_ALLOW_LOCAL_PROVIDER=1

# Remote self-hosting only: HTTPS + authenticated reverse proxy on the same host.
# Change mode to proxy, set the exact HTTPS origin, and supply a fresh random
# 32+ character proxy secret in BOTH the gateway and trusted proxy config.
# FOLIOHUSH_APP_ORIGIN=https://writing.example.com
# FOLIOHUSH_AGENT_MODE=proxy
# FOLIOHUSH_PROXY_TOKEN=
